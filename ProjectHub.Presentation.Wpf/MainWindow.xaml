<Window
    x:Class="ProjectHub.Presentation.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ProjectHub.Presentation.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="ProjectHub"
    Width="1280"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    d:DataContext="{d:DesignInstance viewmodel:MainViewModel}"
    Background="{StaticResource BgPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  Header (spans full width)  -->
        <controls:HeaderView Grid.Row="0" Grid.Column="0" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Left Sidebar  -->
            <controls:SidebarView Grid.Column="0" />
            <!--  GridSplitter between sidebar and content  -->
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
            <!--  Main Content Area (placeholder)  -->
            <Grid Grid.Column="2" Background="{StaticResource BgPrimaryBrush}">
                <controls:ContentView />
            </Grid>
        </Grid>


        <!--  Status Bar (spans full width)  -->
        <controls:StatusBarView Grid.Row="2" />
    </Grid>
</Window>
