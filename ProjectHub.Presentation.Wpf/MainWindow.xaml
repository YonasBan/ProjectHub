<Window x:Class="ProjectHub.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ProjectHub.Presentation.Wpf.Controls"
        xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
        Title="ProjectHub"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        d:DataContext="{d:DesignInstance viewmodel:MainViewModel}"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header (spans full width) -->
        <controls:HeaderView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>

        <!-- Left Sidebar -->
        <controls:SidebarView Grid.Row="1" Grid.Column="0"/>

        <!-- Main Content Area (placeholder) -->
        <Grid Grid.Row="1" Grid.Column="1"
              Background="{StaticResource BgPrimaryBrush}">
            <!-- Content will be added here later -->
            <TextBlock Text="{Binding TestText}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Test language switch buttons (temporary, will be removed) -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Margin="0,40,0,0">
                <Button Content="Switch to English"
                        Command="{Binding SwitchToEnglishCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="&#x5207;&#x6362;&#x4E3A;&#x4E2D;&#x6587;"
                        Command="{Binding SwitchToChineseCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar (spans full width) -->
        <controls:StatusBarView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
