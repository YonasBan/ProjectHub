<rxui:ReactiveWindow
    x:Class="ProjectHub.Presentation.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ProjectHub.Presentation.Wpf.Controls"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="ProjectHub"
    Width="1350"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    d:DataContext="{d:DesignInstance viewmodel:MainViewModel}"
    x:TypeArguments="viewmodel:MainViewModel"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:RectConverter x:Key="RectConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="8"
            GlassFrameThickness="0"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        x:Name="RootBorder"
        Background="{DynamicResource BgPrimaryBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">
        <Border.Clip>
            <RectangleGeometry RadiusX="8" RadiusY="8">
                <RectangleGeometry.Rect>
                    <MultiBinding Converter="{StaticResource RectConverter}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                </RectangleGeometry.Rect>
            </RectangleGeometry>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  自定义标题栏  -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  窗口标题  -->
                    <TextBlock
                        Grid.Column="0"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  窗口控制按钮  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!--  最小化按钮  -->
                        <Button
                            Width="46"
                            Height="32"
                            Click="MinimizeButton_Click"
                            Content="&#xE949;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource WindowControlButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                        <!--  最大化/还原按钮  -->
                        <Button
                            x:Name="MaximizeRestoreButton"
                            Width="46"
                            Height="32"
                            Click="MaximizeRestoreButton_Click"
                            Content="&#xE739;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource WindowControlButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                        <!--  关闭按钮  -->
                        <Button
                            Width="46"
                            Height="32"
                            Click="CloseButton_Click"
                            Content="&#xE10A;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--  Header (spans full width)  -->
            <controls:HeaderView Grid.Row="1" Grid.Column="0" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Left Sidebar  -->
                <controls:SidebarView Grid.Column="0" DataContext="{Binding SidebarViewModel}" />
                <!--  GridSplitter between sidebar and content  -->
                <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Cursor="SizeWE" />
                <!--  Main Content Area (placeholder)  -->
                <Grid Grid.Column="2" Background="{DynamicResource BgPrimaryBrush}">
                    <controls:ContentView DataContext="{Binding ContentViewModel}" />
                </Grid>
            </Grid>
            <!--  Status Bar (spans full width)  -->
            <controls:StatusBarView Grid.Row="3" DataContext="{Binding SidebarViewModel}" />
        </Grid>
    </Border>
</rxui:ReactiveWindow>
