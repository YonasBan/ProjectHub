<Window
    x:Class="ProjectHub.Presentation.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:ProjectHub.Resources.Strings;assembly=ProjectHub.Resources"
    xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance viewmodel:MainViewModel}"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Project_Create}" />
        <TextBlock Text="{Binding L.Project_Create}" />
        <Button Command="{Binding SwitchToEnglishCommand}" Content="Change Localization" />
    </StackPanel>

</Window>
