<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.AddProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding Title}"
    Width="520"
    Height="420"
    d:DataContext="{d:DesignInstance viewmodels:AddProjectDialogViewModel}"
    Background="{StaticResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="{Binding Title}" />

        <!--  表单内容  -->
        <StackPanel Grid.Row="1">

            <!--  项目图标  -->
            <StackPanel
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="64"
                    Height="64"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Image
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" />
                </Border>
                <Button
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding BrowseIconCommand}"
                    Content="浏览..."
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>

            <!--  项目名称  -->
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding NameLabel}" />
            <TextBox
                x:Name="ProjectNameTextBox"
                Padding="10,8"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CaretBrush="{StaticResource TextPrimaryBrush}"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"
                MaxLength="100"
                SelectionBrush="{StaticResource AccentBlueBrush}"
                Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--  打开路径  -->
            <TextBlock
                Margin="0,16,0,6"
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding PathLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Padding="10,8"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CaretBrush="{StaticResource TextPrimaryBrush}"
                    FontSize="14"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    MaxLength="500"
                    SelectionBrush="{StaticResource AccentBlueBrush}"
                    Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding BrowsePathCommand}"
                    Content="..."
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="浏览" />
            </Grid>

            <!--  默认程序  -->
            <TextBlock
                Margin="0,16,0,6"
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding ProgramLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Padding="10,8"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CaretBrush="{StaticResource TextPrimaryBrush}"
                    FontSize="14"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    MaxLength="500"
                    SelectionBrush="{StaticResource AccentBlueBrush}"
                    Text="{Binding DefaultProgram, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Command="{Binding BrowseProgramCommand}"
                    Content="..."
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="浏览" />
            </Grid>

            <!--  错误提示  -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="#FFF44747"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding CancelText}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Width="90"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmText}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
