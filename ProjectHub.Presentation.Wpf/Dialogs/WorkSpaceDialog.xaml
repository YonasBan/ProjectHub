<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.WorkSpaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProjectHub.Presentation.Wpf.Behaviors"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding DialogTitle}"
    Width="640"
    Height="Auto"
    MinHeight="600"
    MaxHeight="800"
    d:Background="AliceBlue"
    d:DataContext="{d:DesignInstance viewmodels:WorkSpaceDialogViewModel}"
    Background="{DynamicResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  表单内容  -->
        <StackPanel Grid.Row="1">
            <!--  步骤1：工作空间基本信息  -->
            <Border
                Margin="0,0,0,8"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.WorkSpaceDialog_Step1_BasicInfo}" />

                    <!--  工作空间名称  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_NameLabel}" />
                    <TextBox
                        Margin="0,0,0,12"
                        MaxLength="100"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding WorkSpaceName, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  描述  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_DescriptionLabel}" />
                    <TextBox
                        Height="32"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  步骤2：选择项目  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.WorkSpaceDialog_Step2_SelectProjects}" />

                    <!--  搜索和工具栏  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding L.WorkSapce_Search}" />
                        <!--  搜索框  -->
                        <TextBox
                            Grid.Column="1"
                            Margin="24,0,0,0"
                            Style="{DynamicResource VSCodeTextBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!--  已选择数量提示  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding SelectedProjectCount, StringFormat='已选择 {0} 个项目'}" />

                    <!--  项目列表  -->
                    <Border
                        Height="200"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableProjects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="12,8"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--  复选框  -->
                                                    <CheckBox
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsSelected}"
                                                        Style="{DynamicResource VSCodeCheckBoxStyle}" />

                                                    <!--  项目图标  -->
                                                    <Image
                                                        Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" />

                                                    <!--  项目信息  -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            Text="{Binding ProjectName}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Text="{Binding ProjectPath}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!--  排序按钮（仅在自定义顺序模式下显示）  -->
                                                    <StackPanel
                                                        Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding DataContext.UseCustomLaunchOrder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Button
                                                            Width="28"
                                                            Height="28"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↑"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                        <Button
                                                            Width="28"
                                                            Height="28"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="↓"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                    </Border>
                </StackPanel>

            </Border>
            <StackPanel Grid.Row="1" Margin="12,0,0,0">
                <!--  默认启动间隔时间  -->
                <StackPanel Orientation="Horizontal">
                    <!--  使用自定义启动顺序  -->
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{Binding L.WorkSpaceDialog_UseCustomLaunchOrder}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        IsChecked="{Binding UseCustomLaunchOrder}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_LaunchIntervalLabel}" />
                    <TextBox
                        Width="60"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding DefaultLaunchIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="秒" />
                </StackPanel>
                <!--  提示信息  -->
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding L.WorkSpaceDialog_LaunchIntervalHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <!--  错误提示  -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="#FFF44747"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{DynamicResource SecondaryButtonStyle}" />
            <Button
                Width="90"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmButtonText}"
                Style="{DynamicResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
