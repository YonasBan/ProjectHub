<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.WorkSpaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProjectHub.Presentation.Wpf.Behaviors"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding DialogTitle}"
    Width="640"
    Height="Auto"
    MinHeight="600"
    MaxHeight="800"
    d:DataContext="{d:DesignInstance viewmodels:WorkSpaceDialogViewModel}"
    Background="{DynamicResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  表单内容  -->
        <StackPanel Grid.Row="1">

            <!--  步骤1：工作空间基本信息  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.WorkSpaceDialog_Step1_BasicInfo}" />

                    <!--  工作空间名称  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_NameLabel}" />
                    <TextBox
                        Margin="0,0,0,12"
                        Padding="10,8"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CaretBrush="{DynamicResource TextPrimaryBrush}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        MaxLength="100"
                        SelectionBrush="{DynamicResource AccentBlueBrush}"
                        Text="{Binding WorkSpaceName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!--  描述  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_DescriptionLabel}" />
                    <TextBox
                        Height="60"
                        Padding="10,8"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CaretBrush="{DynamicResource TextPrimaryBrush}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        MaxLength="500"
                        SelectionBrush="{DynamicResource AccentBlueBrush}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </Border>

            <!--  步骤2：选择项目  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.WorkSpaceDialog_Step2_SelectProjects}" />

                    <!--  搜索和工具栏  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  搜索框  -->
                        <TextBox
                            Grid.Column="0"
                            Padding="10,8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CaretBrush="{DynamicResource TextPrimaryBrush}"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            SelectionBrush="{DynamicResource AccentBlueBrush}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--  全选/取消全选按钮  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Padding="12,8"
                                Command="{Binding SelectAllCommand}"
                                Content="{Binding L.WorkSpaceDialog_SelectAll}"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button
                                Padding="12,8"
                                Command="{Binding DeselectAllCommand}"
                                Content="{Binding L.WorkSpaceDialog_DeselectAll}"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <!--  已选择数量提示  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding SelectedProjectCount, StringFormat='已选择 {0} 个项目'}" />

                    <!--  项目列表  -->
                    <Border
                        Height="200"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailableProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="12,8"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  复选框  -->
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected}" />

                                                <!--  项目图标  -->
                                                <Image
                                                    Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" />

                                                <!--  项目信息  -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Text="{Binding ProjectName}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{Binding ProjectPath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!--  排序按钮（仅在自定义顺序模式下显示）  -->
                                                <StackPanel
                                                    Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding DataContext.UseCustomLaunchOrder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!--  步骤3：启动配置  -->
            <Border
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.WorkSpaceDialog_Step3_LaunchConfig}" />

                    <!--  使用自定义启动顺序  -->
                    <CheckBox
                        Margin="0,0,0,12"
                        Content="{Binding L.WorkSpaceDialog_UseCustomLaunchOrder}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        IsChecked="{Binding UseCustomLaunchOrder}" />

                    <!--  默认启动间隔时间  -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding L.WorkSpaceDialog_LaunchIntervalLabel}" />
                        <TextBox
                            Width="60"
                            Margin="8,0"
                            Padding="8,6"
                            HorizontalContentAlignment="Center"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CaretBrush="{DynamicResource TextPrimaryBrush}"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            SelectionBrush="{DynamicResource AccentBlueBrush}"
                            Text="{Binding DefaultLaunchIntervalSeconds, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="秒" />
                    </StackPanel>

                    <!--  提示信息  -->
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.WorkSpaceDialog_LaunchIntervalHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  错误提示  -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="#FFF44747"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{DynamicResource SecondaryButtonStyle}" />
            <Button
                Width="90"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmButtonText}"
                Style="{DynamicResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
