<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding DialogTitle}"
    Width="560"
    Height="Auto"
    MinHeight="520"
    MaxHeight="700"
    d:DataContext="{d:DesignInstance viewmodels:ProjectDialogViewModel}"
    Background="{DynamicResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  表单内容  -->
        <StackPanel Grid.Row="1">

            <!--  步骤1：选择文件路径  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_Step1_SelectFile}" />
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_PathLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Padding="10,8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CaretBrush="{DynamicResource TextPrimaryBrush}"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            IsReadOnly="{Binding IsEditMode}"
                            MaxLength="500"
                            SelectionBrush="{DynamicResource AccentBlueBrush}"
                            Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,8"
                            Command="{Binding BrowsePathCommand}"
                            Content="{Binding L.ProjectDialog_Browse}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  步骤2：项目信息（选择文件后自动填充，可修改）  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_Step2_ProjectInfo}" />

                    <!--  项目名称  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_NameLabel}" />
                    <TextBox
                        Margin="0,0,0,12"
                        Padding="10,8"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CaretBrush="{DynamicResource TextPrimaryBrush}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        MaxLength="100"
                        SelectionBrush="{DynamicResource AccentBlueBrush}"
                        Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!--  默认程序（可修改）  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_ProgramLabel}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Padding="10,8"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CaretBrush="{DynamicResource TextPrimaryBrush}"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            MaxLength="500"
                            SelectionBrush="{DynamicResource AccentBlueBrush}"
                            Text="{Binding DefaultProgram, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,8"
                            Command="{Binding BrowseProgramCommand}"
                            Content="{Binding L.ProjectDialog_Browse}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    </Grid>

                    <!--  项目图标（可修改）  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_IconLabel}" />
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Border
                            Width="48"
                            Height="48"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Image
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" />
                        </Border>
                        <Button
                            Margin="12,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Command="{Binding BrowseIconCommand}"
                            Content="{Binding L.ProjectDialog_Browse}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Command="{Binding ResetIconCommand}"
                            Content="{Binding L.ProjectDialog_ResetIcon}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  步骤3：项目描述  -->
            <Border
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_Step3_Description}" />
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_DescriptionLabel}" />
                    <TextBox
                        Height="60"
                        Padding="10,8"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CaretBrush="{DynamicResource TextPrimaryBrush}"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        MaxLength="500"
                        SelectionBrush="{DynamicResource AccentBlueBrush}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </Border>

            <!--  错误提示  -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="#FFF44747"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{DynamicResource SecondaryButtonStyle}" />
            <Button
                Width="90"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmButtonText}"
                Style="{DynamicResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
