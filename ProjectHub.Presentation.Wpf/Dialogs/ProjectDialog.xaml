<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.ProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:ProjectHub.Domain.Entities;assembly=ProjectHub.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:ProjectHub.Presentation.Wpf.Selectors"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels.DialogViewModel;assembly=ProjectHub.Application"
    Title="{Binding DialogTitle}"
    Width="560"
    Height="Auto"
    MinHeight="520"
    d:DataContext="{d:DesignInstance viewmodels:ProjectDialogViewModel}"
    Background="{DynamicResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:PathToIconConverter x:Key="PathToIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <!--  打开文件模板  -->
        <DataTemplate x:Key="OpenFileTemplate" DataType="{x:Type domain:LaunchType}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_PathLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        IsReadOnly="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding DataContext.ProjectPath, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding DataContext.BrowsePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding DataContext.L.ProjectDialog_Browse, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Visibility="{Binding DataContext.IsAddMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_ProgramLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <!--  有关联程序时显示下拉选择  -->
                <Grid
                    Margin="0,0,0,12"
                    Visibility="{Binding DataContext.ShowAssociatedPrograms, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        DisplayMemberPath="FriendlyName"
                        ItemsSource="{Binding DataContext.AssociatedPrograms, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValue="{Binding DataContext.DefaultProgram, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="ExePath"
                        Style="{DynamicResource VSCodeComboBoxStyle}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding DataContext.L.ProjectDialog_Browse, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>
                <!--  无关联程序时显示文本输入  -->
                <Grid
                    Margin="0,0,0,12"
                    Visibility="{Binding DataContext.ShowAssociatedPrograms, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding DataContext.DefaultProgram, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding DataContext.L.ProjectDialog_Browse, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_ArgumentsLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox
                    Margin="0,0,0,12"
                    MaxLength="500"
                    Style="{DynamicResource VSCodeTextBoxStyle}"
                    Text="{Binding DataContext.LaunchArguments, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />

                <!--  以管理员身份运行  -->
                <CheckBox
                    Content="{Binding DataContext.L.ProjectDialog_RunAsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    IsChecked="{Binding DataContext.RunAsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource VSCodeCheckBoxStyle}" />
            </StackPanel>
        </DataTemplate>

        <!--  打开 EXE 模板  -->
        <DataTemplate x:Key="OpenExeTemplate" DataType="{x:Type domain:LaunchType}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_ProgramLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding DataContext.DefaultProgram, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding DataContext.L.ProjectDialog_Browse, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>

                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_ArgumentsLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox
                    Margin="0,0,0,12"
                    MaxLength="500"
                    Style="{DynamicResource VSCodeTextBoxStyle}"
                    Text="{Binding DataContext.LaunchArguments, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />

                <!--  以管理员身份运行  -->
                <CheckBox
                    Content="{Binding DataContext.L.ProjectDialog_RunAsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    IsChecked="{Binding DataContext.RunAsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource VSCodeCheckBoxStyle}" />
            </StackPanel>
        </DataTemplate>

        <!--  打开网页模板  -->
        <DataTemplate x:Key="OpenWebUrlTemplate" DataType="{x:Type domain:LaunchType}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_WebUrlLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox
                    MaxLength="500"
                    Style="{DynamicResource VSCodeTextBoxStyle}"
                    Text="{Binding DataContext.WebUrl, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!--  运行 CMD 命令模板  -->
        <DataTemplate x:Key="OpenCmdTemplate" DataType="{x:Type domain:LaunchType}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_CmdCommandLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox
                    Height="80"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    MaxLength="1000"
                    Style="{DynamicResource VSCodeTextBoxStyle}"
                    Text="{Binding DataContext.CmdCommand, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,16,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding DataContext.L.ProjectDialog_CmdWorkingDirectoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding DataContext.CmdWorkingDirectory, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Command="{Binding DataContext.BrowseWorkingDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding DataContext.L.ProjectDialog_Browse, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>

                <!--  保持窗口打开  -->
                <CheckBox
                    Margin="0,8,0,0"
                    Content="{Binding DataContext.L.ProjectDialog_CmdKeepWindowOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    IsChecked="{Binding DataContext.CmdKeepWindowOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{DynamicResource VSCodeCheckBoxStyle}" />
            </StackPanel>
        </DataTemplate>

        <!--  启动类型模板选择器  -->
        <selectors:LaunchTypeTemplateSelector
            x:Key="LaunchTypeTemplateSelector"
            OpenExeTemplate="{StaticResource OpenExeTemplate}"
            OpenFileTemplate="{StaticResource OpenFileTemplate}"
            OpenWebUrlTemplate="{StaticResource OpenWebUrlTemplate}"
            OpenCmdTemplate="{StaticResource OpenCmdTemplate}" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  表单内容  -->
        <StackPanel Grid.Row="0">

            <!--  步骤1：启动方式选择（放在最上面）  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_LaunchTypeLabel}" />
                    <ComboBox
                        Margin="0,0,0,16"
                        DisplayMemberPath="DisplayName"
                        ItemContainerStyle="{DynamicResource VSCodeComboBoxItemStyle}"
                        ItemsSource="{Binding LaunchTypeItems}"
                        SelectedValue="{Binding LaunchType}"
                        SelectedValuePath="Type"
                        Style="{DynamicResource VSCodeComboBoxStyle}" />

                    <!--  使用 ContentControl + TemplateSelector 根据启动类型显示不同模板  -->
                    <ContentControl Content="{Binding LaunchType}" ContentTemplateSelector="{StaticResource LaunchTypeTemplateSelector}" />
                </StackPanel>
            </Border>

            <!--  步骤2：项目信息  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_Step2_ProjectInfo}" />
                    <!--  项目名称  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_NameLabel}" />
                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="100"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  项目图标（可修改）  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding L.ProjectDialog_IconLabel}" />
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Border
                            Width="48"
                            Height="48"
                            Background="{DynamicResource BgPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Image
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding IconPath, Converter={StaticResource PathToIconConverter}}" />
                        </Border>
                        <Button
                            Margin="12,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Command="{Binding BrowseIconCommand}"
                            Content="{Binding L.ProjectDialog_Browse}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            Command="{Binding ResetIconCommand}"
                            Content="{Binding L.ProjectDialog_ResetIcon}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  步骤3：项目描述  -->
            <Border
                Padding="16"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBlueBrush}"
                        Text="{Binding L.ProjectDialog_Step3_Description}" />
                    <TextBox
                        Height="40"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        MaxLength="500"
                        Style="{DynamicResource VSCodeTextBoxStyle}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  错误提示  -->
            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="#FFF44747"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{DynamicResource SecondaryButtonStyle}" />
            <Button
                Width="90"
                Command="{Binding ConfirmCommand}"
                Content="{Binding ConfirmButtonText}"
                Style="{DynamicResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
