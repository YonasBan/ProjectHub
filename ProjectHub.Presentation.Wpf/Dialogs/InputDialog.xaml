<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProjectHub.Presentation.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding L.Sidebar_NewFolder}"
    Width="420"
    Height="300"
    d:DataContext="{d:DesignInstance viewmodel:CreateFolderDialogViewModel}"
    Background="{StaticResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--  Enter 键确认  -->
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <!--  Escape 键取消  -->
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="{Binding L.Sidebar_NewFolder}" />

        <!--  输入区域  -->
        <StackPanel Grid.Row="1">
            <TextBlock
                Margin="0,0,0,6"
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding L.Folder_InputLabel}" />

            <TextBox
                x:Name="FolderNameTextBox"
                Padding="10,8"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CaretBrush="{StaticResource TextPrimaryBrush}"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"
                MaxLength="100"
                SelectionBrush="{StaticResource AccentBlueBrush}"
                Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--  错误提示  -->
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12"
                Foreground="#FF6B6B"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{Binding L.Confirm}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
