<Window
    x:Class="ProjectHub.Presentation.Wpf.Dialogs.SelectFolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogViewModel="clr-namespace:ProjectHub.Application.ViewModels.DialogViewModel;assembly=ProjectHub.Application"
    xmlns:local="clr-namespace:ProjectHub.Presentation.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    Title="{Binding Title}"
    Width="420"
    Height="480"
    d:DataContext="{d:DesignInstance dialogViewModel:SelectFolderDialogViewModel}"
    Background="{DynamicResource BgPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="{Binding Title}" />

        <!--  项目/工作空间名称  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,16"
            FontSize="13"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="{Binding ItemName}"
            TextTrimming="CharacterEllipsis" />

        <!--  文件夹树  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <TreeView
                x:Name="FolderTreeView"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Folders}"
                SelectedItemChanged="FolderTreeView_SelectedItemChanged">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type dialogViewModel:FolderTreeItemViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <!--  文件夹图标或加载动画  -->
                            <Grid
                                Width="20"
                                Height="16"
                                Margin="2,0">
                                <TextBlock
                                    x:Name="FolderIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="📂"
                                    Visibility="{Binding IsLoadingChildren, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="⏳"
                                    Visibility="{Binding IsLoadingChildren, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding Name}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <!--  新建文件夹区域  -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  新建文件夹按钮  -->
            <Button
                Grid.Row="0"
                HorizontalAlignment="Left"
                Command="{Binding CreateNewFolderCommand}"
                Content="{Binding L.Folder_CreateNew}"
                Style="{StaticResource LinkButtonStyle}" />

            <!--  新建文件夹输入框  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,8,0,0"
                Visibility="{Binding IsCreatingNewFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding L.Folder_NewFolderName}" />
                <TextBox
                    MaxLength="100"
                    Style="{DynamicResource VSCodeTextBoxStyle}"
                    Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <!--  错误提示  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontSize="12"
            Foreground="#FF6B6B"
            Text="{Binding ErrorMessage}"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  按钮区域  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="{Binding L.Cancel}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="{Binding L.Confirm}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
