<UserControl
    x:Class="ProjectHub.Presentation.Wpf.Controls.HeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:ProjectHub.Resources.Strings;assembly=ProjectHub.Resources"
    xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    d:DesignHeight="48"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource BgTertiaryBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Logo  -->
            <StackPanel
                Grid.Column="0"
                Margin="16,0,24,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Logo Icon (gradient square)  -->
                <Border
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FF0078D4" />
                            <GradientStop Offset="1" Color="#FFC586C0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentBlueBrush}"
                    Text="ProjectHub" />
            </StackPanel>

            <!--  Search Bar  -->
            <Border
                Grid.Column="1"
                Height="32"
                MaxWidth="480"
                Margin="0,0,24,0"
                VerticalAlignment="Center"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Search Icon  -->
                    <svg:SvgViewbox
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        Source="/Icons/search.svg"
                        Stretch="Uniform" />
                    <TextBox
                        x:Name="SearchInput"
                        Grid.Column="1"
                        Style="{StaticResource SearchTextBoxStyle}"
                        Tag="{Binding L.Header_Search, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="SearchInput_OnTextChanged" />
                </Grid>
            </Border>

            <!--  Header Actions  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  语言切换按钮  -->
                <Button
                    x:Name="LanguageButton"
                    Width="32"
                    Height="32"
                    Margin="0,0,8,0"
                    Padding="4"
                    Command="{Binding ToggleLanguageCommand}"
                    Content="&#x1F310;"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding L.Header_Language}" />
                <!--  主题切换按钮  -->
                <Button
                    x:Name="ThemeButton"
                    Width="32"
                    Height="32"
                    Margin="0,0,8,0"
                    Padding="4"
                    Command="{Binding ToggleThemeCommand}"
                    Content="&#x2600;"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding L.Header_Theme}" Cursor="Hand" />
                <!--  设置按钮  -->
                <Button
                    x:Name="SettingsButton"
                    Width="32"
                    Height="32"
                    Padding="4"
                    Content="&#x2699;"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{Binding L.Header_Settings}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
