<UserControl x:Class="ProjectHub.Presentation.Wpf.Controls.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:ProjectHub.Resources.Strings;assembly=ProjectHub.Resources"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="800">
    <Border Background="{StaticResource BgTertiaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,24,0">
                <!-- Logo Icon (gradient square) -->
                <Border Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0078D4" Offset="0"/>
                            <GradientStop Color="#FFC586C0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="ProjectHub"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlueBrush}"/>
            </StackPanel>

            <!-- Search Bar -->
            <Border Grid.Column="1"
                    MaxWidth="480"
                    Height="32"
                    Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Search Icon -->
                    <TextBlock Grid.Column="0"
                               Text="&#x1F50D;"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchInput"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="{Binding L.Header_Search, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchInput_OnTextChanged"/>
                </Grid>
            </Border>

            <!-- Header Actions -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="&#x2699;"
                        FontSize="14"
                        Padding="8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
