<UserControl
    x:Class="ProjectHub.Presentation.Wpf.Controls.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    xmlns:viewmodels="clr-namespace:ProjectHub.Application.ViewModels;assembly=ProjectHub.Application"
    d:DataContext="{d:DesignInstance viewmodels:MainViewModel}"
    d:DesignWidth="260"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border
        Background="{StaticResource BgSecondaryBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Sidebar Header  -->
            <Border
                Grid.Row="0"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource SidebarTitleStyle}"
                        Text="{Binding L.Sidebar_WorkFolders}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Content="+"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding L.Sidebar_NewFolder}" />
                        <Button
                            Content="&#x27F3;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding L.Sidebar_Refresh}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Tree View  -->
            <TreeView
                x:Name="NavigationTree"
                Grid.Row="1"
                Padding="0,8,0,8"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource SidebarTreeViewItemStyle}"
                ItemsSource="{Binding SidebarTreeItems}"
                Loaded="NavigationTree_OnLoaded">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type viewmodels:TreeItemViewModel}" ItemsSource="{Binding Children}">
                        <Border
                            x:Name="ItemBorder"
                            Padding="8,6,16,6"
                            Background="Transparent"
                            CornerRadius="0"
                            MouseEnter="ItemBorder_MouseEnter"
                            MouseLeave="ItemBorder_MouseLeave"
                            MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp"
                            Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Expand/Collapse Arrow  -->
                                <TextBlock
                                    x:Name="ExpandArrow"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Tag="{Binding}"
                                    Text="&#x25B6;">

                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ExpandRotation" Angle="0" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#x25BC;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  Icon (using SharpVectors for SVG)  -->
                                <svg:SvgViewbox
                                    Grid.Column="1"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding IconPath}" />

                                <!--  Label  -->
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding Name}" />

                                <!--  Count Badge  -->
                                <Border
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TreeCountBadgeStyle}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding Count}" />
                                </Border>

                                <!--  Add Button (visible on hover)  -->
                                <Button
                                    Grid.Column="4"
                                    Width="20"
                                    Height="20"
                                    Content="+"
                                    FontSize="14"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{Binding DataContext.L.Sidebar_NewSubFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding IsHovered, Converter={StaticResource BoolToVis}}" />

                                <!--  Delete Button (visible on hover)  -->
                                <Button
                                    Grid.Column="5"
                                    Width="20"
                                    Height="20"
                                    Margin="4,0,0,0"
                                    Content="&#x00D7;"
                                    FontSize="14"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{Binding DataContext.L.Sidebar_DeleteFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding IsHovered, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
