<UserControl x:Class="ProjectHub.Presentation.Wpf.Controls.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ProjectHub.Presentation.Wpf.Models"
             xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignWidth="260">
    <UserControl.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding L.Sidebar_WorkFolders, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource SidebarTitleStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="+" ToolTip="{Binding L.Sidebar_NewFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="&#x27F3;" ToolTip="{Binding L.Sidebar_Refresh, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tree View -->
            <TreeView Grid.Row="1"
                      x:Name="NavigationTree"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0,8,0,8"
                      Loaded="NavigationTree_OnLoaded"
                      ItemContainerStyle="{StaticResource SidebarTreeViewItemStyle}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:TreeItemViewModel}"
                                            ItemsSource="{Binding Children}">
                        <Border x:Name="ItemBorder"
                                Padding="8,6,16,6"
                                Background="Transparent"
                                CornerRadius="0"
                                Tag="{Binding}"
                                MouseEnter="ItemBorder_MouseEnter"
                                MouseLeave="ItemBorder_MouseLeave"
                                MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Expand/Collapse Arrow -->
                                <TextBlock Grid.Column="0"
                                           x:Name="ExpandArrow"
                                           Text="&#x25B6;"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5"
                                           Tag="{Binding}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ExpandRotation" Angle="0"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#x25BC;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Icon -->
                                <Border Grid.Column="1"
                                        Width="20" Height="20"
                                        CornerRadius="4"
                                        Background="{StaticResource AccentBlueBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Label -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>

                                <!-- Count Badge -->
                                <Border Grid.Column="3"
                                        Style="{StaticResource TreeCountBadgeStyle}"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Count}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>

                                <!-- Add Button (visible on hover) -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="20" Height="20"
                                        Content="+"
                                        FontSize="14"
                                        Visibility="{Binding IsHovered, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding L.Sidebar_NewSubFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <!-- Delete Button (visible on hover) -->
                                <Button Grid.Column="5"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="20" Height="20"
                                        Content="&#x00D7;"
                                        FontSize="14"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsHovered, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding L.Sidebar_DeleteFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
