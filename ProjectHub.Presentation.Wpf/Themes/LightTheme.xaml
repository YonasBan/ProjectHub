<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== Colors (VS Code Light Theme) ==========  -->
    <!-- 背景色 -->
    <Color x:Key="BgPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="BgSecondaryColor">#FFF3F3F3</Color>
    <Color x:Key="BgTertiaryColor">#FFECECEC</Color>
    <Color x:Key="BgHoverColor">#FFE5E5E5</Color>

    <!-- 强调色 -->
    <Color x:Key="AccentBlueColor">#FF0078D4</Color>
    <Color x:Key="AccentBlueHoverColor">#FF106EBE</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#FF333333</Color>
    <Color x:Key="TextSecondaryColor">#FF616161</Color>
    <Color x:Key="TextMutedColor">#FF999999</Color>

    <!-- 边框色 -->
    <Color x:Key="BorderColor">#FFE0E0E0</Color>

    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#FF28A745</Color>
    <Color x:Key="WarningColor">#FFFFA500</Color>
    <Color x:Key="ErrorColor">#FFDC3545</Color>

    <!--  ========== TreeViewItem Colors ==========  -->
    <Color x:Key="TreeViewItemHoverBgColor">#FFE8E8E8</Color>
    <Color x:Key="TreeViewItemSelectedBgColor">#FFE0E0E0</Color>
    <Color x:Key="TreeViewItemSelectedHoverBgColor">#FFD0D0D0</Color>
    <Color x:Key="TreeViewItemDisabledFgColor">#FFAAAAAA</Color>
    <Color x:Key="TreeViewItemArrowColor">#FF666666</Color>
    <Color x:Key="TreeViewItemArrowHoverColor">#FF333333</Color>
    <Color x:Key="TreeViewItemSelectedIndicatorColor">#FF0078D4</Color>

    <!--  ========== GridSplitter Colors ==========  -->
    <Color x:Key="GridSplitterColor">#FFE0E0E0</Color>
    <Color x:Key="GridSplitterHoverColor">#FFCCCCCC</Color>
    <Color x:Key="GridSplitterDraggingColor">#FF0078D4</Color>

    <!--  ========== SolidColorBrushes ==========  -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItemHoverBgBrush" Color="{StaticResource TreeViewItemHoverBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedBgBrush" Color="{StaticResource TreeViewItemSelectedBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedHoverBgBrush" Color="{StaticResource TreeViewItemSelectedHoverBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemDisabledFgBrush" Color="{StaticResource TreeViewItemDisabledFgColor}" />
    <SolidColorBrush x:Key="TreeViewItemArrowBrush" Color="{StaticResource TreeViewItemArrowColor}" />
    <SolidColorBrush x:Key="TreeViewItemArrowHoverBrush" Color="{StaticResource TreeViewItemArrowHoverColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedIndicatorBrush" Color="{StaticResource TreeViewItemSelectedIndicatorColor}" />
    <SolidColorBrush x:Key="GridSplitterBrush" Color="{StaticResource GridSplitterColor}" />
    <SolidColorBrush x:Key="GridSplitterHoverBrush" Color="{StaticResource GridSplitterHoverColor}" />
    <SolidColorBrush x:Key="GridSplitterDraggingBrush" Color="{StaticResource GridSplitterDraggingColor}" />

    <!--  ========== Converters ==========  -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

</ResourceDictionary>
