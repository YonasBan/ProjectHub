<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== Colors (VS Code Dark Theme) ==========  -->
    <Color x:Key="BgPrimaryColor">#FF1E1E1E</Color>
    <Color x:Key="BgSecondaryColor">#FF252526</Color>
    <Color x:Key="BgTertiaryColor">#FF2D2D30</Color>
    <Color x:Key="BgHoverColor">#FF3E3E42</Color>
    <Color x:Key="AccentBlueColor">#FF0078D4</Color>
    <Color x:Key="AccentBlueHoverColor">#FF1084D8</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFCCCCCC</Color>
    <Color x:Key="TextMutedColor">#FF858585</Color>
    <Color x:Key="BorderColor">#FF3C3C3C</Color>
    <Color x:Key="SuccessColor">#FF4EC9B0</Color>
    <Color x:Key="WarningColor">#FFCCA700</Color>
    <Color x:Key="ErrorColor">#FFF44747</Color>

    <!--  ========== TreeViewItem Colors ==========  -->
    <Color x:Key="TreeViewItemHoverBgColor">#FF3E3E42</Color>
    <Color x:Key="TreeViewItemSelectedBgColor">#330078D4</Color>
    <Color x:Key="TreeViewItemSelectedHoverBgColor">#FF4E4E52</Color>
    <Color x:Key="TreeViewItemDisabledFgColor">#FF5A5A5A</Color>
    <Color x:Key="TreeViewItemArrowColor">#FF858585</Color>
    <Color x:Key="TreeViewItemArrowHoverColor">#FFCCCCCC</Color>
    <Color x:Key="TreeViewItemSelectedIndicatorColor">#FF0078D4</Color>

    <!--  ========== GridSplitter Colors ==========  -->
    <Color x:Key="GridSplitterColor">#FF2D2D30</Color>
    <Color x:Key="GridSplitterHoverColor">#FF3E3E42</Color>
    <Color x:Key="GridSplitterDraggingColor">#FF0078D4</Color>

    <!--  ========== SolidColorBrushes ==========  -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgTertiaryBrush" Color="{StaticResource BgTertiaryColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="TreeViewItemHoverBgBrush" Color="{StaticResource TreeViewItemHoverBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedBgBrush" Color="{StaticResource TreeViewItemSelectedBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedHoverBgBrush" Color="{StaticResource TreeViewItemSelectedHoverBgColor}" />
    <SolidColorBrush x:Key="TreeViewItemDisabledFgBrush" Color="{StaticResource TreeViewItemDisabledFgColor}" />
    <SolidColorBrush x:Key="TreeViewItemArrowBrush" Color="{StaticResource TreeViewItemArrowColor}" />
    <SolidColorBrush x:Key="TreeViewItemArrowHoverBrush" Color="{StaticResource TreeViewItemArrowHoverColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedIndicatorBrush" Color="{StaticResource TreeViewItemSelectedIndicatorColor}" />
    <SolidColorBrush x:Key="GridSplitterBrush" Color="{StaticResource GridSplitterColor}" />
    <SolidColorBrush x:Key="GridSplitterHoverBrush" Color="{StaticResource GridSplitterHoverColor}" />
    <SolidColorBrush x:Key="GridSplitterDraggingBrush" Color="{StaticResource GridSplitterDraggingColor}" />

    <!--  ========== Converters ==========  -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

</ResourceDictionary>
