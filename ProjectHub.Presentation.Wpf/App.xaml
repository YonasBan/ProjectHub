<Application
    x:Class="ProjectHub.Presentation.Wpf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ProjectHub.Presentation.Wpf.Converters"
    xmlns:local="clr-namespace:ProjectHub.Presentation.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认主题 - 程序启动时加载，后续由 WpfThemeService 管理切换 -->
                <ResourceDictionary Source="pack://application:,,,/ProjectHub.Presentation.Wpf;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  转换器  -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:BoolToFavoriteIconConverter x:Key="BoolToFavoriteIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
